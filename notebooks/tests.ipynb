   "source": [
    "## Random Parameter Sampling Benchmark"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 109,
   "id": "c2a0cdf6",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      " 50 / 500 done...\n",
      " 100 / 500 done...\n",
      " 150 / 500 done...\n",
      " 200 / 500 done...\n",
      " 250 / 500 done...\n",
      " 300 / 500 done...\n",
      " 350 / 500 done...\n",
      " 400 / 500 done...\n",
      " 450 / 500 done...\n",
      " 500 / 500 done...\n",
      "\n",
      " Total Cases: 500\n",
      "Runtime: 1215.9s\n",
      "Mean |Accuracy|: 0.0266\n",
      "Max |Accuracy|: 0.1630\n",
      "within 2 s.e.: 430/500\n",
      "|Accuracy| < 0.05: 412/500\n",
      "\n",
      "                   Accuracy           Within 2se\n",
      "                      mean       std   <lambda>\n",
      "Moneyness_Bucket                               \n",
      "ITM (Put)         0.000106  0.037932   0.656566\n",
      "ATM               0.004860  0.044509   1.000000\n",
      "OTM (Put)         0.012636  0.034499   0.989744\n"
     ]
